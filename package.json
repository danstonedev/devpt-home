{
  "name": "devpt-app",
  "version": "2.0.0",
  "description": "DevPT \u2014 master hub for physical therapy education simulation tools (devpt.app)",
  "main": "index.js",
  "scripts": {
    "prestart": "node scripts/ensure-fresh-main.mjs",
    "start": "npx http-server -c-1 -p 8099",
    "prepreview": "node scripts/ensure-fresh-main.mjs --preview",
    "preview": "http-server -c-1 -p 8109 -a 127.0.0.1",
    "test": "node scripts/check-live-showcase.mjs && node scripts/check-apps.mjs --no-ping && npm run check:brand && node --test scripts/wait-for-showcases.test.mjs && node --test scripts/wait-for-teaching-catalog.test.mjs",
    "build:demos": "node scripts/build-demos.mjs",
    "preview:teaching": "node scripts/serve-local-site.mjs --open",
    "build:teaching-preview": "node scripts/build-local-site.mjs",
    "package:teaching-preview": "node scripts/package-local-site.mjs",
    "check:walkthrough": "node scripts/check-live-showcase.mjs",
    "test:ui": "playwright test",
    "check:brand": "node scripts/sync-emr-foundation.mjs --check --snapshot-only",
    "check:brand:source": "node scripts/sync-emr-foundation.mjs --check --source ../devpt-emr-platform",
    "sync:brand": "node scripts/sync-emr-foundation.mjs --source ../devpt-emr-platform",
    "build:local": "node scripts/build-local-site.mjs",
    "preview:local": "node scripts/serve-local-site.mjs --open",
    "package:local": "node scripts/package-local-site.mjs",
    "check:local-ui": "node scripts/check-local-site-ui.mjs",
    "build:local-physics": "node scripts/build-local-physics.mjs",
    "check:local-delivery": "node scripts/check-local-delivery.mjs",
    "check:local-emr": "node scripts/check-local-emr-ui.mjs",
    "build:public": "node scripts/build-public-site.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "esbuild": "0.25.12",
    "http-server": "^14.1.1",
    "lz-string": "1.5.0",
    "svelte": "5.56.4",
    "three": "0.183.2",
    "three-mesh-bvh": "0.9.10",
    "vite": "6.4.3",
    "zod": "3.25.76"
  }
}
